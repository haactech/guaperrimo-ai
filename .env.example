# --- Server ---
PORT=8080
LOG_LEVEL=info
# Optional shared secret; when set the app must send X-API-Key
API_KEY=
# How phones reach this server; images are served from here with signed links.
# Default: first LAN IPv4 of this machine + PORT, e.g. http://192.168.100.39:8080
PUBLIC_BASE_URL=
IMAGE_URL_TTL=720h

# --- LLM (OpenAI-compatible chat completions with tool calling) ---
# mistral | moonshot | openai
LLM_PROVIDER=mistral
# Defaults per provider: MISTRAL_API_KEY / MOONSHOT_API_KEY / OPENAI_API_KEY also work
LLM_API_KEY=
# LLM_MODEL=mistral-large-latest
# VISION_MODEL=mistral-large-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# --- Shopping: real products + nearby stores (serpapi.com) ---
# Without a key the server uses FAKE data so the flow still runs end to end.
SERPAPI_KEY=
SEARCH_LOCATION=Mexico
DEFAULT_RADIUS_M=1500

# --- Sessions ---
# Empty = in-memory sessions (lost on restart). With Postgres they persist.
POSTGRES_URL=
# POSTGRES_URL=postgres://guaperrimo:guaperrimo@localhost:5432/guaperrimo?sslmode=disable
SESSION_TTL=24h

# --- Cloudflare R2 (required: user photos and try-on images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Virtual try-on (optional, Google Vertex AI) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
# GCP_SA_KEY_JSON=   (production; locally use `gcloud auth application-default login`)
VTON_BASE_STEPS=20
VTON_TIMEOUT=60s
LOOK_GENERATION_TIMEOUT=180s
# try-on renders in parallel; prefetch (one-swipe neighbours) uses at most this many of them
RENDER_CONCURRENCY=3
RENDER_PREFETCH_CONCURRENCY=2
# options per row in the mix-and-match grid
MATRIX_MAX_PER_SLOT=3
# one extra SerpAPI call per rendered product for larger photos + merchant link
RESOLVE_PRODUCT_DETAILS=true

# --- Agent ---
AGENT_MAX_STEPS=12
AGENT_MAX_QUESTIONS=6
# search_products calls allowed per turn (each takes seconds on SerpAPI)
AGENT_MAX_SEARCHES=8
AGENT_TURN_TIMEOUT=150s

# --- Tracing (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
