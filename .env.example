# --- Server ---
PORT=8080
LOG_LEVEL=info
# Optional shared secret; when set the app must send X-API-Key
API_KEY=
# How phones reach this server; images are served from here with signed links.
# Default: first LAN IPv4 of this machine + PORT, e.g. http://192.168.100.39:8080
PUBLIC_BASE_URL=
IMAGE_URL_TTL=720h

# --- LLM (OpenAI-compatible chat completions with tool calling) ---
# mistral | moonshot | openai
LLM_PROVIDER=mistral
# Defaults per provider: MISTRAL_API_KEY / MOONSHOT_API_KEY / OPENAI_API_KEY also work
LLM_API_KEY=
# LLM_MODEL=mistral-large-latest
# VISION_MODEL=mistral-large-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# --- Shopping: real products + nearby stores (serpapi.com) ---
# Without a key the server uses FAKE data so the flow still runs end to end.
SERPAPI_KEY=
SEARCH_LOCATION=Mexico
DEFAULT_RADIUS_M=1500

# --- Sessions ---
# Empty = in-memory sessions (lost on restart). With Postgres they persist.
POSTGRES_URL=
# POSTGRES_URL=postgres://guaperrimo:guaperrimo@localhost:5432/guaperrimo?sslmode=disable
SESSION_TTL=24h

# --- Cloudflare R2 (required: user photos and try-on images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Virtual try-on (optional) ---
# gemini (~0.134 USD per look, whole outfit incl. pants in one call)
# | fashn (~0.075 USD per garment, chained, no pants)
# | google_vertex (~1.07 USD per garment, chained)
VTON_PROVIDER=gemini
# Gemini image editing ("Nano Banana"). The key needs a paid AI Studio tier:
# the free tier has no image quota.
# gemini-3-pro-image ~0.134 USD/image (most faithful);
# gemini-3.1-flash-lite-image ~0.034 USD/image (faster, more mistakes).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6
# performance | balanced | quality
FASHN_MODE=balanced
# Google Vertex AI settings (for VTON_PROVIDER or TRYON_LOWER_PROVIDER=google_vertex)
GCP_PROJECT_ID=
GCP_REGION=us-central1
# GCP_SA_KEY_JSON=   (production; locally use `gcloud auth application-default login`)
VTON_BASE_STEPS=20
VTON_TIMEOUT=60s
LOOK_GENERATION_TIMEOUT=180s
# try-on renders in parallel; prefetch (one-swipe neighbours) uses at most this many of them
# Every try-on image is billed (Gemini Pro ~0.134, Vertex ~1.07 USD per image,
# Oct 2026); with gemini one image is one whole look.
# Hard limits enforced before calling the provider; counters reset on restart.
TRYON_MAX_PER_SESSION=4
TRYON_MAX_PER_DAY=10
# Complete look for chained providers: pants rendered last, on top of the
# grid image, by another provider (FASHN leaves pants unchanged; Vertex
# replaces them). Empty = off. Ignored with gemini, which does pants itself.
# Own hard limits, because Vertex costs ~1.07 USD per image. Needs the Vertex
# settings above (GCP_PROJECT_ID + credentials) when set to google_vertex.
TRYON_LOWER_PROVIDER=
TRYON_LOWER_MAX_PER_SESSION=1
TRYON_LOWER_MAX_PER_DAY=3
# Render the agent's looks automatically after the recommendation (costs images nobody asked for)
TRYON_AUTO_LOOKS=false
RENDER_CONCURRENCY=3
RENDER_PREFETCH_CONCURRENCY=2
# options per row in the mix-and-match grid
MATRIX_MAX_PER_SLOT=3
# one extra SerpAPI call per rendered product for larger photos + merchant link
RESOLVE_PRODUCT_DETAILS=true

# --- Agent ---
AGENT_MAX_STEPS=12
AGENT_MAX_QUESTIONS=6
# search_products calls allowed per turn (each takes seconds on SerpAPI)
AGENT_MAX_SEARCHES=8
# Style preview: the agent proposes a palette and 3-6 garment ideas with a
# reference photo (one product search each) and waits for the user's pick
# before searching. Needs an app that handles input_mode "preview".
AGENT_PREVIEW=false
AGENT_TURN_TIMEOUT=150s

# --- Tracing (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
